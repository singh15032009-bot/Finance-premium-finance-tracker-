# Copy to .env and fill in your own values. NEVER commit the real .env --
# it is gitignored, and a secret key in a public repo is compromised the
# moment it is pushed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On Vercel, `vercel env pull` writes POSTGRES_URL (and friends) into .env
# automatically once a Postgres store is attached to the project. The app
# reads whichever of these it finds, in this order:
#
#   WEALTHTRACK_DATABASE_URL   (your own override, wins over everything)
#   POSTGRES_URL               (Vercel/Neon pooled -- the right one for serverless)
#   DATABASE_URL
#   POSTGRES_URL_NON_POOLING
#   POSTGRES_PRISMA_URL
#
# With NONE of these set, the app falls back to local JSON file storage --
# that is the intended local-development mode, so you can run without a
# database. Set WEALTHTRACK_DATA_DIR to choose where those files live.
#
# WEALTHTRACK_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/wealthtrack
# WEALTHTRACK_DATA_DIR=./data

# Used only by the test suite; Postgres tests skip when it is unset.
# WEALTHTRACK_TEST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/wealthtrack

# ---------------------------------------------------------------------------
# Stripe -- https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
# Nothing in the current codebase reads these yet: /api/checkout deliberately
# returns 501 rather than pretending to charge.
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Price IDs created in the Stripe dashboard for each plan
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_LIFETIME=price_xxx
